<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Base platform theme applied at the Activity/window level (splash-to-Compose
        handoff, system bars). The actual Material3 ColorScheme used inside Compose
        content lives in Theme.kt, not here — this XML theme only controls what the
        OS needs before/around Compose takes over (window background, status bar).
    -->
    <style name="Theme.ProjectJanus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/janus_background</item>
        <item name="android:statusBarColor">@color/janus_background</item>
        <item name="android:navigationBarColor">@color/janus_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>